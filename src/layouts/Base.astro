---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site, ordered } from '../data/site';
import { getPosts, readingTime } from '../lib/posts';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  bare?: boolean;
  published?: Date;
  modified?: Date;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  type = 'website',
  image = '/og.png',
  noindex = false,
  bare = false,
  published,
  modified,
  jsonLd = [],
} = Astro.props;

// Search results cut titles near 60 characters and descriptions near 160.
const suffixed = title ? `${title} · ${site.shortName}` : site.title;
const fullTitle = title && type === 'article' && suffixed.length > 60 ? title : suffixed;
const clip = (text: string, max = 158) => {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  return `${cut.slice(0, cut.lastIndexOf(' ')).replace(/[\s,;:.]+$/, '')}…`;
};
const metaDescription = clip(description);
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/$/, '$1');
const canonical = new URL(cleanPath, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const path = cleanPath;
const posts = bare ? [] : await getPosts();
const short = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const palette = [
  {
    name: 'Pages',
    items: [
      { label: 'Home', href: '/', hint: 'Page', d: 'The hero, the system map and selected work' },
      { label: 'Work', href: '/work', hint: 'Page', d: `All ${ordered.length} projects, each with a glimpse of its interface` },
      { label: 'About', href: '/about', hint: 'Page', d: 'Experience, how I work and the stack I use' },
      { label: 'Writing', href: '/blog', hint: 'Page', d: `${posts.length} posts on engineering, AI and design` },
      { label: 'Get in touch', href: '/#contact', hint: 'Section', d: 'Contact me by email or hire me on Upwork' },
    ],
  },
  {
    name: 'Projects',
    items: ordered.map((p) => ({ label: p.name, href: `/work#${p.slug}`, hint: 'Project', d: p.summary })),
  },
  {
    name: 'Writing',
    items: posts.map((p) => ({ label: p.data.title, href: `/blog/${p.id}`, hint: readingTime(p.body), d: p.data.description })),
  },
  {
    name: 'Actions',
    items: [
      { label: 'Switch theme', act: 'theme', hint: 'Action', d: 'Change between light and dark mode' },
      { label: 'Switch sound', act: 'sound', hint: 'Action', d: 'Turn the audio on or off (mute)' },
      { label: 'Switch the swarm', act: 'swarm', hint: 'Action', d: 'Turn the cursors and the build animation on or off' },
      { label: 'Replay the build', act: 'build', hint: 'Action', d: 'Draw this page again from blank, or skip a build in progress' },
      { label: 'Copy email address', act: 'email', hint: 'Action', d: site.email },
    ],
  },
  {
    name: 'Elsewhere',
    items: [
      { label: 'GitHub', href: site.github, hint: 'New tab', d: short(site.github) },
      { label: 'LinkedIn', href: site.linkedin, hint: 'New tab', d: short(site.linkedin) },
      { label: 'Upwork', href: site.upwork, hint: 'New tab', d: 'Hire me for freelance work' },
    ],
  },
];
let palId = 0;
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Writing' },
];
---

<!doctype html>
<html lang="en" data-bare={bare ? '' : undefined} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={site.name} />
    <meta name="keywords" content={site.keywords.join(', ')} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.shortName}, writing`} href="/rss.xml" />
    <meta name="theme-color" content="#f4f4f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.shortName}, ${site.role}`} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={site.name} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={imageUrl} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <ClientRouter fallback="swap" />
    <script is:inline>
      (() => {
        const d = document.documentElement;
        const apply = () => {
          let t = null;
          try {
            t = localStorage.getItem('theme');
          } catch {}
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
          else delete d.dataset.theme;
        };
        apply();
        document.addEventListener('click', (e) => {
          if (!e.target.closest || !e.target.closest('[data-theme-toggle]')) return;
          const dark = d.dataset.theme === 'dark' || (!d.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
          try {
            localStorage.setItem('theme', dark ? 'light' : 'dark');
          } catch {}
          apply();
        });

        // Start blank only when the swarm is going to build the page.
        const blank = (first) => {
          let off = false;
          try {
            off = localStorage.getItem('swarm') === 'off';
          } catch {}
          if (d.hasAttribute('data-bare') || off || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          d.classList.add('building');
          if (!first) return;
          // First page of a visit opens behind the loader. Crawlers skip it.
          let entered = true;
          try {
            entered = sessionStorage.getItem('entered') === '1';
          } catch {}
          if (!entered && !/bot|crawl|spider|lighthouse|headless/i.test(navigator.userAgent)) d.classList.add('intro');
          // If the scripts never arrive, show the page anyway.
          setTimeout(() => {
            if (!window.__swarm || !window.__shell) d.classList.remove('building', 'intro');
          }, 3500);
        };
        blank(true);
        // Moving between pages swaps the content without a reload, so the page keeps its
        // state (and its sound). Set the theme and the blank state again before it paints.
        document.addEventListener('astro:after-swap', () => {
          apply();
          blank(false);
        });
      })();
    </script>
    <noscript><style>.dock [data-pal-open], .dock [data-sound-toggle] { display: none; } html.building [data-b], html.building .prose > * { visibility: visible !important; }</style></noscript>
  </head>
  <body>
    {
      bare ? (
        <slot />
      ) : (
        <>
          <div class="intro-el" data-intro role="dialog" aria-modal="true" aria-labelledby="intro-t">
            <p class="intro-meta">
              <span>{site.shortName}</span>
              <span>{site.role}</span>
            </p>
            <div class="intro-mid">
              <p class="intro-n" aria-hidden="true"><span data-intro-n>000</span></p>
              <p class="intro-t" id="intro-t" data-intro-line aria-live="polite">Loading the swarm</p>
              <div class="intro-acts" data-intro-acts>
                <button type="button" class="btn" data-intro-enter="on" data-swarm disabled>
                  Enter with sound <span aria-hidden="true">↗</span>
                </button>
                <button type="button" class="intro-quiet" data-intro-enter="off" data-swarm disabled>Enter without sound</button>
              </div>
            </div>
            <p class="intro-foot">The sound is made in your browser and can be switched off from the corner at any time.</p>
          </div>
          <a class="skip" href="#main">Skip to content</a>
          <div class="guide guide-l" data-b="g" aria-hidden="true" />
          <div class="guide guide-r" data-b="g" aria-hidden="true" />
          <header class="top" data-top>
            <div class="top-in">
              <a class="brand" href="/" data-swarm>
                <span class="brand-name" data-b="t">{site.shortName}</span>
                <span class="brand-role" data-b="t">{site.role}</span>
              </a>
              <p class="clock" data-b="t">
                Islamabad · <span data-clock>--:--:--</span>
              </p>
              <nav aria-label="Primary">
                {nav.map((n) => (
                  <a href={n.href} data-b="t" aria-current={path.startsWith(n.href) ? 'page' : undefined}>
                    {n.label}
                  </a>
                ))}
                <a class="btn" href="/#contact" data-b="r" data-swarm data-magnet>
                  Get in touch <span aria-hidden="true">↗</span>
                </a>
              </nav>
            </div>
          </header>
          <div class="frame">
            <hr class="top-rule" data-b="l" />
            <main id="main">
              <slot />
            </main>
            <footer class="foot">
              <hr data-b="l" />
              <div class="foot-cols">
                <div>
                  <h2 data-b="t">Pages</h2>
                  <ul>
                    <li><a href="/" data-b="t">Home</a></li>
                    <li><a href="/work" data-b="t">Work</a></li>
                    <li><a href="/about" data-b="t">About</a></li>
                    <li><a href="/blog" data-b="t">Writing</a></li>
                  </ul>
                </div>
                <div>
                  <h2 data-b="t">Elsewhere</h2>
                  <ul>
                    <li><a href={site.github} rel="me" data-b="t">GitHub ↗</a></li>
                    <li><a href={site.linkedin} rel="me" data-b="t">LinkedIn ↗</a></li>
                    <li><a href={site.upwork} rel="me" data-b="t">Upwork ↗</a></li>
                    <li><a href={`mailto:${site.email}`} data-b="t">Email ↗</a></li>
                  </ul>
                </div>
                <div>
                  <h2 data-b="t">Colophon</h2>
                  <p class="credit" data-b="t">
                    This page is built by cursors each time you load it, after <a href="https://califa.github.io/swarm-site/">Swarm</a> by
                    Joel Califa and <a href="https://github.com/DhvanilPatel/swarm-cursors">Swarm Rebuild</a> by Dhvanil Patel. Set in Geist.
                    The controls are in the corner.
                  </p>
                </div>
              </div>
              <p class="wordmark" data-b="t" aria-hidden="true">{site.shortName}</p>
              <p class="legal" data-b="t">© {new Date().getFullYear()} {site.name} · {site.location}</p>
            </footer>
          </div>
          <aside class="dock" aria-label="Site controls">
            <span class="dock-label" data-hud-label hidden></span>
            <button type="button" data-pal-open aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K">
              Menu <kbd>⌘K</kbd>
            </button>
            <button type="button" data-hud-btn>Skip</button>
            <button type="button" data-sound-toggle aria-pressed="false">Sound off</button>
            <button type="button" data-swarm-toggle aria-pressed="true">Swarm on</button>
            <button type="button" data-theme-toggle>Theme</button>
          </aside>
          <dialog class="pal" data-pal data-email={site.email} aria-label="Command menu">
            <div class="pal-top">
              <input
                type="text"
                data-pal-input
                placeholder="Search pages, projects, posts and actions"
                autocomplete="off"
                spellcheck="false"
                role="combobox"
                aria-expanded="true"
                aria-controls="pal-list"
                aria-autocomplete="list"
                aria-label="Search the site"
              />
              <kbd>esc</kbd>
            </div>
            <div class="pal-list" id="pal-list" role="listbox" aria-label="Results" data-pal-list>
              {palette.map((g) => (
                <div role="group" aria-label={g.name} data-pal-group>
                  <p class="pal-h" aria-hidden="true">
                    {g.name}
                  </p>
                  {g.items.map((i) =>
                    'href' in i ? (
                      <a role="option" aria-selected="false" tabindex="-1" id={`pal-${palId++}`} href={i.href}>
                        <span class="pal-main">
                          <span class="pal-t" data-pal-text>{i.label}</span>
                          <span class="pal-d" data-pal-text>{i.d}</span>
                        </span>
                        <small>{i.hint}</small>
                      </a>
                    ) : (
                      <button type="button" role="option" aria-selected="false" tabindex="-1" id={`pal-${palId++}`} data-act={i.act}>
                        <span class="pal-main">
                          <span class="pal-t" data-pal-text>{i.label}</span>
                          <span class="pal-d" data-pal-text>{i.d}</span>
                        </span>
                        <small>{i.hint}</small>
                      </button>
                    ),
                  )}
                </div>
              ))}
            </div>
            <p class="pal-empty" data-pal-empty hidden>Nothing matches <b data-pal-q></b>. Try a page, a project or a topic.</p>
            <p class="pal-foot" aria-hidden="true">
              <span class="pal-count" data-pal-count></span>
              <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
              <span><kbd>↵</kbd> open</span>
              <span><kbd>esc</kbd> close</span>
            </p>
          </dialog>
          <canvas id="swarm" aria-hidden="true" />
        </>
      )
    }
    {!bare && <script src="../scripts/shell.ts" />}
    {!bare && <script src="../scripts/swarm.ts" />}
    {!bare && <script src="../scripts/motion.ts" />}
  </body>
</html>
