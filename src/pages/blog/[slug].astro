---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { getPosts, readingTime, formatDate, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const url = `${site.url}/blog/${post.id}`;
const words = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${url}#post`,
    mainEntityOfPage: url,
    url,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    dateModified: (post.data.updated ?? post.data.date).toISOString(),
    wordCount: words,
    keywords: post.data.tags.join(', '),
    inLanguage: 'en',
    image: `${site.url}/og.png`,
    author: { '@type': 'Person', '@id': `${site.url}/#person`, name: site.name, url: site.url },
    publisher: { '@type': 'Person', '@id': `${site.url}/#person`, name: site.name },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Writing', item: `${site.url}/blog` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---

<Base
  title={post.data.title}
  description={post.data.description}
  type="article"
  published={post.data.date}
  modified={post.data.updated ?? post.data.date}
  jsonLd={jsonLd}
>
  <article class="post">
    <aside class="post-aside">
      <a href="/blog" data-b="t" data-swarm>← Writing</a>
      <time datetime={post.data.date.toISOString()} data-b="t">{formatDate(post.data.date)}</time>
      <span data-b="t">{readingTime(post.body)}</span>
      {post.data.tags.length > 0 && <span data-b="t">{post.data.tags.join(' · ')}</span>}
    </aside>
    <div class="post-body">
      <h1 data-b="t">{post.data.title}</h1>
      <p class="standfirst" data-b="t">{post.data.description}</p>
      <div class="prose">
        <Content />
      </div>
      <footer>
        <p data-b="t">
          Written by {site.shortName}. Reach me at <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </footer>
    </div>
  </article>
</Base>
